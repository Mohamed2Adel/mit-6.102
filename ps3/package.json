{
  "name": "ps3",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compile": "tsc",
    "watch": "tsc --watch --preserveWatchOutput",
    "test": "npm run compile && mocha -r source-map-support/register --exit \"dist/test/**/*.test.js\"",
    "coverage": "npm run compile && c8 --reporter=html --reporter=text --exclude \"dist/test/**\" mocha -r source-map-support/register --exit \"dist/test/**/*.test.js\"",
    "start": "npm run compile && node -r source-map-support/register dist/src/main.js",
    "web": "npm run compile && node dist/src/webserver.js",
    "examples": "npm run compile && node dist/src/examples.js",
    "lint": "eslint src test"
  },
  "dependencies": {
    "canvas": "^3.1.0",
    "parserlib": "file:./lib/parserlib-4.0.2.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.2.5",
    "c8": "^10.1.3",
    "eslint": "^9.20.0",
    "mocha": "^11.1.0",
    "source-map-support": "^0.5.21",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  }
}
